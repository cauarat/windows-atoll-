{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/crash-hook.sh SessionStart",
            "timeout": 20,
            "statusMessage": "Checking for Notchy crashes…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/crash-hook.sh Stop",
            "timeout": 20,
            "statusMessage": "Checking for Notchy crashes…"
          }
        ]
      }
    ]
  }
}
