# Serviço local de ditado do Notchy — configuração.
# Copie para .env e mude o que precisar. Nenhum valor aqui é secreto: o serviço
# não usa chave nem senha, e não fala com nenhuma API paga.

# Onde o serviço escuta. 127.0.0.1 = só este computador. Para usar uma GPU de
# outra máquina da rede, ponha 0.0.0.0 nela (o serviço não tem senha: só numa
# rede em que você confia) e o endereço dela nas Configurações do Notchy.
DICTATION_HOST=127.0.0.1
DICTATION_PORT=8765

# qwen3-asr (padrão) ou voxtral-realtime (comparação; veja o README).
DICTATION_PROVIDER=qwen3-asr
DICTATION_MODEL=Qwen/Qwen3-ASR-1.7B

# auto: vllm (streaming, com texto parcial) quando há vLLM e GPU NVIDIA;
# senão transformers (o texto aparece ao parar de falar).
DICTATION_BACKEND=auto
# Só para o backend transformers: auto, cuda:0, mps ou cpu.
DICTATION_DEVICE=auto
# auto escolhe bfloat16 na GPU NVIDIA, float16 no Apple silicon, float32 na CPU.
DICTATION_DTYPE=auto

# Idioma do reconhecimento. Por enquanto, português do Brasil.
DICTATION_LANGUAGE=pt-BR

# Streaming (backend vllm), com os valores do demo oficial de microfone do
# Qwen3-ASR: a cada DICTATION_CHUNK_SECONDS de áudio novo o modelo relê tudo e
# o texto parcial pode mudar.
DICTATION_CHUNK_SECONDS=1.0
DICTATION_UNFIXED_CHUNKS=4
DICTATION_UNFIXED_TOKENS=5
DICTATION_GPU_MEMORY_UTILIZATION=0.8

# Duração máxima de um ditado, em segundos.
DICTATION_MAX_SECONDS=300

# Manter o modelo aquecido: parado, ele esfria (no Apple silicon, a primeira
# transcrição depois de 2 minutos ociosos levou 24 s em vez de 2). -1 = automático
# (a cada 30 s no MPS, desligado no resto), 0 = desligado, ou um número de segundos.
DICTATION_KEEP_WARM_SECONDS=-1

# Palavras que o modelo deve esperar (nomes, siglas), separadas por vírgula.
DICTATION_CONTEXT=

# Voxtral Realtime (só com DICTATION_PROVIDER=voxtral-realtime): o servidor
# vLLM que roda o modelo, iniciado à parte.
VOXTRAL_URL=ws://127.0.0.1:8000/v1/realtime
VOXTRAL_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602

DICTATION_LOG_LEVEL=info
