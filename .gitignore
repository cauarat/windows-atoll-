NotchBuddy/build/
NotchBuddy/NotchBuddy.xcodeproj/project.xcworkspace/xcuserdata/
NotchBuddy/NotchBuddy.xcodeproj/xcuserdata/
*.xcuserstate

# Xcode DerivedData (outside repo — listed for clarity)
DerivedData/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# iCloud stubs
*.icloud

# Local only (never published)
# …but not the hooks, which have to travel: a worktree per task means a fresh
# .claude/ every week, and a crash watch that only exists in the worktree that
# wrote it is a crash watch nobody runs. The contents and not the directory,
# because git never looks inside an excluded directory and the negation below
# would never be read.
.claude/*
!.claude/settings.json
_prive/
NotchBuddy/NotchBuddy.xcodeproj/xcshareddata/
NotchBuddy/Frameworks/
